# 環境変数ファイル（.env.local.example をコピーして .env.local として使用）

# Supabase設定
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# LINE Notify設定（オプション）
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# サイトのURL（オプション。未設定ならリクエスト元から自動判定）
# 例: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# サーバー専用の鍵（NEXT_PUBLIC_ を付けない。ブラウザに渡してはいけない）
# Supabase 管理画面 > Project Settings > API の service_role キー
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# チームログインのセッションに署名する秘密の文字列（32文字以上）
# 作り方の例: openssl rand -base64 48
# 変えると全員がログアウトされる
SESSION_SECRET=generate-a-long-random-string

# LINE Messaging API（LINE Developers コンソールのチャネル設定）
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_GROUP_ID=your-line-group-id
# Webhook の署名確認に使う（チャネル基本設定 > チャネルシークレット）
LINE_CHANNEL_SECRET=your-channel-secret
